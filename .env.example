# Local PostgreSQL. Either the Windows/macOS install on 5432, or `docker compose up -d` (also 5432).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://tokotech:tokotech@localhost:5432/tokotech?schema=public"

# Auth.js: generate with `npx auth secret` or any 32+ random bytes (base64)
AUTH_SECRET=""
# Google sign-in: fill both to enable the Google button
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Midtrans sandbox (dashboard.sandbox.midtrans.com > Settings > Access Keys); empty = mock payments
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
# Biteship testing key; empty = mock courier rates
BITESHIP_API_KEY=""
# Resend; empty = emails are logged to the console
RESEND_API_KEY=""
EMAIL_FROM="TokoTech <onboarding@resend.dev>"
# Public base URL (payment redirects, email links)
APP_URL="http://localhost:3000"
# Password given to every seeded user (dev only)
SEED_USER_PASSWORD="tokotech123"
# Shared secret for the Biteship tracking webhook (?secret=...) and hosted cron calls (Bearer)
BITESHIP_WEBHOOK_SECRET=""
CRON_SECRET=""
# Warehouse (shipping origin)
WAREHOUSE_POSTAL_CODE="12190"
WAREHOUSE_PHONE=""
WAREHOUSE_ADDRESS=""
